bmarks := bringup-bench

BENCH_DIR := $(DEPS_DIR)/bringup-bench

# Compilatore Cheshire
CC      := riscv-rtems7-gcc  # o riscv-none-elf-gcc se bare-metal puro
CFLAGS  := -DTARGET_CHESHIRE -march=rv64imafdc -mabi=lp64d \
           -mstrict-align -static -mcmodel=medany \
           -nostdlib -nostartfiles -ffreestanding \
           -Wall -O3 -g

# Sorgenti comuni
LIBTARG_SRC := $(BSP_DIR)/libtarg.c
CRT0_SPM    := $(BSP_DIR)/cheshire-crt0.S
CRT0_DDR    := $(BSP_DIR)/cheshire-crt0.S
LD_SPM      := $(BSP_DIR)/cheshire-spm-map.ld
LD_DDR      := $(BSP_DIR)/cheshire-ddr-map.ld